# Copy this file to .env and fill in real values.
# .env is git-ignored — it will never be committed.

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# LDAP / Active Directory
LDAP_SERVER=192.168.56.10
LDAP_PORT=389
LDAP_SSL_PORT=636
LDAP_BASE_DN=DC=bank,DC=local
LDAP_USER_SEARCH_BASE=DC=bank,DC=local
LDAP_BIND_DN=CN=Administrator,CN=Users,DC=bank,DC=local
LDAP_BIND_PASSWORD=change-this-to-your-real-lab-password
